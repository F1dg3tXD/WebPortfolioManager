# Optional — for development with `node server.js`
# The built binary uses ~/.manage-app/config.json instead
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
REPO=Spewku/Spewku.github.io
DATA_PATH=artData.json
PORT=3322
# Optional — path to a Chrome/Edge/Chromium executable used to fetch
# Cloudflare-protected ArtStation pages. If unset, the server looks for an
# installed browser (Edge/Chrome/Chromium/Brave). On Windows/macOS/Linux an
# installed browser is normally found automatically.
# AS_BROWSER=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
